pragma solidity ^0.8.26;

import {Test, console2} from "forge-std/Test.sol";
import {Pricing} from "../../src/libraries/Pricing.sol";
import {PricingHarness} from "../mocks/PricingHarness.sol";

/// @notice Checks the Pricing library against reference/pricing_reference.py vectors
///         (generated by reference/gen_vectors.py into test/vectors/pricing.json). Exact equality everywhere,
///         except lnWad (solady approximation) which is held to LN_TOL wei.
contract PricingVectorsTest is Test {
    PricingHarness internal h;
    string internal json;

    /// @dev lnWad budget used by the variance tolerance in gen_vectors.py (2 wei per call)
    uint256 internal constant LN_TOL = 2;
    uint256 internal constant MAX_LOGGED = 5;
    /// @dev per-call gas cap so a runaway adjust loop shows up as a counted failure, not a suite-wide OOG
    uint256 internal constant CALL_GAS = 2_000_000;

    function setUp() public {
        h = new PricingHarness();
        json = vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/pricing.json"));
    }

    function _u(string memory key) internal view returns (uint256[] memory) {
        return vm.parseJsonUintArray(json, key);
    }

    function _i(string memory key) internal view returns (int256[] memory) {
        return vm.parseJsonIntArray(json, key);
    }

    function _b(string memory key) internal view returns (bool[] memory) {
        return vm.parseJsonBoolArray(json, key);
    }

    function _isNoQuote(bytes memory err) internal pure returns (bool) {
        return err.length == 4 && bytes4(err) == Pricing.NoQuote.selector;
    }

    function _report(string memory name, uint256 total, uint256 bad) internal pure {
        console2.log(name, "vectors:", total);
        console2.log("  mismatches:", bad);
    }

    // ------------------------------------------------------------------ mid / payoff / skew / spread

    function test_vectors_midLong_and_payoutLong() public view {
        uint256[] memory S = _u(".midLong.S");
        uint256[] memory v = _u(".midLong.v");
        uint256[] memory cap = _u(".midLong.vCap");
        uint256[] memory exp = _u(".midLong.expected");
        uint256 bad;
        for (uint256 i; i < S.length; ++i) {
            uint256 a = h.midLong(S[i], v[i], cap[i]);
            uint256 b = h.payoutLong(S[i], v[i], cap[i]);
            if (a != exp[i] || b != exp[i]) {
                if (++bad <= MAX_LOGGED) console2.log("midLong mismatch idx", i, a, exp[i]);
            }
            // I2 and the cap
            assertLe(b, S[i]);
            assertEq(b + (S[i] - b), S[i]);
        }
        _report("midLong/payoutLong", S.length, bad);
        assertEq(bad, 0);
    }

    function test_vectors_skewed() public view {
        uint256[] memory mid = _u(".skewed.mid");
        uint256[] memory kap = _u(".skewed.kappa");
        int256[] memory skew = _i(".skewed.skew");
        uint256[] memory S = _u(".skewed.S");
        uint256[] memory exp = _u(".skewed.expected");
        uint256 bad;
        for (uint256 i; i < mid.length; ++i) {
            uint256 got = h.skewed(mid[i], kap[i], skew[i], S[i]);
            if (got != exp[i] && ++bad <= MAX_LOGGED) console2.log("skewed mismatch idx", i, got, exp[i]);
        }
        _report("skewed", mid.length, bad);
        assertEq(bad, 0);
    }

    function test_vectors_halfSpread() public view {
        uint256[] memory S = _u(".halfSpread.S");
        uint256[] memory h0 = _u(".halfSpread.h0");
        uint256[] memory hm = _u(".halfSpread.hMin");
        uint256[] memory T = _u(".halfSpread.T");
        uint256[] memory e = _u(".halfSpread.e");
        uint256[] memory exp = _u(".halfSpread.expected");
        uint256 bad;
        for (uint256 i; i < S.length; ++i) {
            uint256 got = h.halfSpread(S[i], h0[i], hm[i], T[i], e[i]);
            if (got != exp[i] && ++bad <= MAX_LOGGED) {
                console2.log("halfSpread mismatch idx", i, got, exp[i]);
                console2.log("   S, T, e", S[i], T[i], e[i]);
            }
        }
        _report("halfSpread", S.length, bad);
        assertEq(bad, 0);
    }

    // ------------------------------------------------------------------ buys

    function test_vectors_buyCost() public view {
        uint256[] memory a0 = _u(".buyCost.a0");
        uint256[] memory lam = _u(".buyCost.lambda");
        uint256[] memory n = _u(".buyCost.n");
        uint256[] memory exp = _u(".buyCost.expected");
        uint256 bad;
        for (uint256 i; i < a0.length; ++i) {
            uint256 got = h.buyCost(a0[i], lam[i], n[i]);
            if (got != exp[i] && ++bad <= MAX_LOGGED) {
                console2.log("buyCost mismatch idx", i, got, exp[i]);
                console2.log("   a0, lambda, n", a0[i], lam[i], n[i]);
            }
        }
        _report("buyCost", a0.length, bad);
        assertEq(bad, 0);
    }

    function test_vectors_maxBuy() public view {
        uint256[] memory a0 = _u(".maxBuy.a0");
        uint256[] memory lam = _u(".maxBuy.lambda");
        uint256[] memory S = _u(".maxBuy.S");
        uint256[] memory exp = _u(".maxBuy.expected");
        uint256 bad;
        for (uint256 i; i < a0.length; ++i) {
            uint256 got = h.maxBuy(a0[i], lam[i], S[i]);
            if (got != exp[i] && ++bad <= MAX_LOGGED) console2.log("maxBuy mismatch idx", i, got, exp[i]);
        }
        _report("maxBuy", a0.length, bad);
        assertEq(bad, 0);
    }

    /// @dev reference = LARGEST n with buyCost(n) <= x (found by exact search, not by the sqrt formula)
    function test_vectors_buyUnitsForInput() public view {
        uint256[] memory a0 = _u(".buyUnitsForInput.a0");
        uint256[] memory lam = _u(".buyUnitsForInput.lambda");
        uint256[] memory x = _u(".buyUnitsForInput.x");
        uint256[] memory exp = _u(".buyUnitsForInput.expected");
        uint256 bad;
        uint256 badDefaultLambda;
        uint256 maxShort;
        for (uint256 i; i < a0.length; ++i) {
            try h.buyUnitsForInput{gas: CALL_GAS}(a0[i], lam[i], x[i]) returns (uint256 got) {
                if (got != exp[i]) {
                    if (exp[i] > got && exp[i] - got > maxShort) maxShort = exp[i] - got;
                    if (lam[i] == 2e15) ++badDefaultLambda;
                    if (++bad <= MAX_LOGGED) {
                        console2.log("buyUnitsForInput mismatch idx", i, got, exp[i]);
                        console2.log("   a0, lambda, x", a0[i], lam[i], x[i]);
                    }
                }
            } catch {
                if (lam[i] == 2e15) ++badDefaultLambda;
                if (++bad <= MAX_LOGGED) console2.log("buyUnitsForInput revert/out-of-gas idx", i, lam[i], x[i]);
            }
        }
        _report("buyUnitsForInput", a0.length, bad);
        console2.log("  max units short of the optimum:", maxShort);
        console2.log("  mismatches with default lambda 2e15:", badDefaultLambda);
        assertEq(bad, 0);
    }

    // ------------------------------------------------------------------ sells

    function test_vectors_maxSell() public view {
        uint256[] memory b0 = _u(".maxSell.b0");
        uint256[] memory lam = _u(".maxSell.lambda");
        uint256[] memory exp = _u(".maxSell.expected");
        uint256 bad;
        for (uint256 i; i < b0.length; ++i) {
            uint256 got = h.maxSell(b0[i], lam[i]);
            if (got != exp[i] && ++bad <= MAX_LOGGED) console2.log("maxSell mismatch idx", i, got, exp[i]);
        }
        _report("maxSell", b0.length, bad);
        assertEq(bad, 0);
    }

    function test_vectors_sellProceeds() public view {
        uint256[] memory b0 = _u(".sellProceeds.b0");
        uint256[] memory lam = _u(".sellProceeds.lambda");
        uint256[] memory n = _u(".sellProceeds.n");
        uint256[] memory exp = _u(".sellProceeds.expected");
        bool[] memory rev = _b(".sellProceeds.reverts");
        uint256 bad;
        for (uint256 i; i < b0.length; ++i) {
            bool ok;
            try h.sellProceeds(b0[i], lam[i], n[i]) returns (uint256 got) {
                ok = !rev[i] && got == exp[i];
                if (!ok && bad < MAX_LOGGED) {
                    console2.log("sellProceeds mismatch idx", i, got, exp[i]);
                    console2.log("   b0, lambda, n", b0[i], lam[i], n[i]);
                }
            } catch (bytes memory err) {
                ok = rev[i] && _isNoQuote(err);
                if (!ok && bad < MAX_LOGGED) console2.log("sellProceeds unexpected revert idx", i);
            }
            if (!ok) ++bad;
        }
        _report("sellProceeds", b0.length, bad);
        assertEq(bad, 0);
    }

    /// @dev reference = SMALLEST n <= maxSell with sellProceeds(n) >= x, NoQuote if none
    function test_vectors_sellUnitsForOutput() public view {
        uint256[] memory b0 = _u(".sellUnitsForOutput.b0");
        uint256[] memory lam = _u(".sellUnitsForOutput.lambda");
        uint256[] memory x = _u(".sellUnitsForOutput.x");
        uint256[] memory exp = _u(".sellUnitsForOutput.expected");
        bool[] memory rev = _b(".sellUnitsForOutput.reverts");
        uint256 bad;
        uint256 badDefaultLambda;
        uint256 maxOver;
        for (uint256 i; i < b0.length; ++i) {
            bool ok;
            try h.sellUnitsForOutput{gas: CALL_GAS}(b0[i], lam[i], x[i]) returns (uint256 got) {
                ok = !rev[i] && got == exp[i];
                if (!rev[i] && got > exp[i] && got - exp[i] > maxOver) maxOver = got - exp[i];
                if (!ok && bad < MAX_LOGGED) {
                    console2.log("sellUnitsForOutput mismatch idx", i, got, exp[i]);
                    console2.log("   b0, lambda, x", b0[i], lam[i], x[i]);
                }
            } catch (bytes memory err) {
                ok = rev[i] && _isNoQuote(err);
                if (!ok && bad < MAX_LOGGED) console2.log("sellUnitsForOutput unexpected revert idx", i, x[i]);
            }
            if (!ok) {
                ++bad;
                if (lam[i] == 2e15) ++badDefaultLambda;
            }
        }
        _report("sellUnitsForOutput", b0.length, bad);
        console2.log("  max units above the optimum:", maxOver);
        console2.log("  mismatches with default lambda 2e15:", badDefaultLambda);
        assertEq(bad, 0);
    }

    // ------------------------------------------------------------------ ln

    function test_vectors_lnWad_error() public view {
        uint256[] memory x = _u(".lnWad.x");
        int256[] memory exp = _i(".lnWad.expected");
        uint256 maxErr;
        uint256 argMax;
        for (uint256 i; i < x.length; ++i) {
            int256 got = h.lnWad(int256(x[i]));
            int256 d = got - exp[i];
            uint256 ad = uint256(d < 0 ? -d : d);
            if (ad > maxErr) {
                maxErr = ad;
                argMax = x[i];
            }
        }
        console2.log("lnWad vectors:", x.length);
        console2.log("  max |lnWad - exact ln| (wei):", maxErr);
        console2.log("  at x:", argMax);
        assertLe(maxErr, LN_TOL);
    }

    // ------------------------------------------------------------------ properties (fuzz)

    /// @dev inverse functions round-trip under maker-favouring rounding (spec §12)
    function testFuzz_buy_roundTrip(uint256 a0, uint256 x) public view {
        a0 = bound(a0, 1, 1e18 - 1);
        x = bound(x, 0, 1e22);
        uint256 lam = 2e15;
        uint256 n = h.buyUnitsForInput(a0, lam, x);
        assertLe(h.buyCost(a0, lam, n), x, "pays more than x");
        assertGt(h.buyCost(a0, lam, n + 1), x, "n is not the largest");
    }

    function testFuzz_sell_roundTrip(uint256 b0, uint256 x) public view {
        b0 = bound(b0, 1, 1e18);
        uint256 lam = 2e15;
        uint256 cap = h.maxSell(b0, lam);
        uint256 pmax = h.sellProceeds(b0, lam, cap);
        x = bound(x, 0, pmax);
        uint256 n = h.sellUnitsForOutput(b0, lam, x);
        assertGe(h.sellProceeds(b0, lam, n), x, "receives less than x");
        if (n > 0) assertLt(h.sellProceeds(b0, lam, n - 1), x, "n is not the smallest");
    }

    function testFuzz_payout_I2_and_cap(uint256 S, uint256 v, uint256 vCap) public view {
        S = bound(S, 1, 1e30);
        vCap = bound(vCap, 1, 1e30);
        v = bound(v, 0, 1e32);
        uint256 pl = h.payoutLong(S, v, vCap);
        assertLe(pl, S);
        assertEq(pl + (S - pl), S);
        if (v >= vCap) assertEq(pl, S);
    }
}
